<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<PackageManifestPath>$(CmdPalPackageManifest)</PackageManifestPath>

		<RuntimeIdentifiers>$(CmdPalRuntimeIdentifiers)</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

		<PublishProfile Condition="'$(_IsPublishing)' == 'true'">win-$(Platform).pubxml</PublishProfile>
		<DebugType>embedded</DebugType>
		<GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
		<!-- Remove this symbol to compile out the experimental full metadata page. -->
		<DefineConstants>$(DefineConstants);FF_ENABLE_FULL_METADATA_PAGE</DefineConstants>

		<AssemblyName>$(CmdPalExtensionAssemblyName)</AssemblyName>
		<Company>Jiri Polasek</Company>
		<Copyright>(c) Jiri Polasek</Copyright>
		<NeutralLanguage>$(CmdPalDefaultLanguage)</NeutralLanguage>
		<Product>Media Controls Command Palette</Product>
		<AssemblyTitle>Media Controls Command Palette</AssemblyTitle>
		<ApplicationIcon>Resources\app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Update="Assets\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<Content Include="Resources\app.ico" />
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="JPSoftworks.CommandPalette.Extensions.Toolkit" />
		<PackageReference Include="JPSoftworks.CommandPalette.Extensions.Toolkit.Logging.MicrosoftExtensions" />
		<PackageReference Include="Microsoft.CommandPalette.Extensions" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MediaControlsExtension.Media\JPSoftworks.MediaControlsExtension.Media.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Uncomment (or pass -p:ForceManagedPublish=true) to publish managed, untrimmed
		     output in Release while tracking an issue down. -->
		<!-- <ForceManagedPublish>true</ForceManagedPublish> -->
		<PublishAot Condition="'$(PublishAot)' == '' and '$(Configuration)' == 'Release' and '$(ForceManagedPublish)' != 'true'">true</PublishAot>
		<PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
		<SelfContained>true</SelfContained>
		<IsAotCompatible>true</IsAotCompatible>
		<CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
		<CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<!-- Keep the CsWinRT Windows.Foundation fallback warning visible without failing AOT. -->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);IL2081</WarningsNotAsErrors>

		<PublishTrimmed Condition="'$(PublishTrimmed)' == ''">$(PublishAot)</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<PublishSingleFile>false</PublishSingleFile>
		<BuiltInComInteropSupport>false</BuiltInComInteropSupport>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<Target Name="UpdateVersionFromPackageManifest" BeforeTargets="BeforeBuild">
		<XmlPeek XmlInputPath="$(PackageManifestPath)" Query="/appx:Package/appx:Identity/@Version" Namespaces="&lt;Namespace Prefix='appx' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
			<Output TaskParameter="Result" PropertyName="appxManifestVersion" />
		</XmlPeek>

		<Message Importance="High" Text="Set project version to match Appx manifest: $(appxManifestVersion)" />

		<PropertyGroup>
			<Version>$(appxManifestVersion)</Version>
		</PropertyGroup>
	</Target>

	<Target Name="KillRunningExecutable" BeforeTargets="Build;Deploy;Publish">
		<PropertyGroup>
			<ExecutableName>$(AssemblyName).exe</ExecutableName>
		</PropertyGroup>

		<Exec Command="taskkill /F /IM $(ExecutableName)" ContinueOnError="true" IgnoreExitCode="true" />
	</Target>
</Project>
