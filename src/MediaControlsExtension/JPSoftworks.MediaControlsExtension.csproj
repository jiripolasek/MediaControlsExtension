<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<RootNamespace>JPSoftworks.MediaControlsExtension</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<PackageManifestPath>$(MSBuildThisFileDirectory)..\MediaControlsExtension.Package\Package.appxmanifest</PackageManifestPath>

		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

		<PublishProfile Condition="'$(_IsPublishing)' == 'true'">win-$(Platform).pubxml</PublishProfile>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<DebugType>embedded</DebugType>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
		<!-- Remove this symbol to compile out the experimental full metadata page. -->
		<DefineConstants>$(DefineConstants);FF_ENABLE_FULL_METADATA_PAGE</DefineConstants>

		<AssemblyName>JPSoftworks.MediaControlsExtension</AssemblyName>
		<Company>Jiri Polasek</Company>
		<Copyright>(c) Jiri Polasek</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Product>Media Controls Command Palette</Product>
		<AssemblyTitle>Media Controls Command Palette</AssemblyTitle>
	</PropertyGroup>

	<ItemGroup>
		<None Update="Assets\IconThemes\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="Assets\MediaHeroPlaceholder.png;Assets\Square40x40-lightunplated.png;Assets\Square40x40-unplated.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<Content Include="Resources\app.ico" />
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="JPSoftworks.CommandPalette.Extensions.Toolkit" />
		<PackageReference Include="Microsoft.CommandPalette.Extensions" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MediaControlsExtension.Media\JPSoftworks.MediaControlsExtension.Media.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<PublishAot>true</PublishAot>
		<SelfContained>true</SelfContained>
		<IsAotCompatible>true</IsAotCompatible>
		<CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
		<CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
		<!-- Keep the Windows SDK fallback and Serilog's unused structure-destructuring warning visible without failing AOT. -->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);IL2081;IL2067</WarningsNotAsErrors>

		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
		<PublishSingleFile>false</PublishSingleFile>
		<BuiltInComInteropSupport>false</BuiltInComInteropSupport>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\app.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Compile Update="Resources\Strings.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Strings.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\Strings.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Strings.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<Target Name="UpdateVersionFromPackageManifest" BeforeTargets="BeforeBuild">
		<XmlPeek XmlInputPath="$(PackageManifestPath)" Query="/appx:Package/appx:Identity/@Version" Namespaces="&lt;Namespace Prefix='appx' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
			<Output TaskParameter="Result" PropertyName="appxManifestVersion" />
		</XmlPeek>

		<Message Importance="High" Text="Set project version to match Appx manifest: $(appxManifestVersion)" />

		<PropertyGroup>
			<Version>$(appxManifestVersion)</Version>
		</PropertyGroup>
	</Target>

	<Target Name="KillRunningExecutable" BeforeTargets="Build;Deploy;Publish">
		<PropertyGroup>
			<ExecutableName>$(AssemblyName).exe</ExecutableName>
		</PropertyGroup>

		<Exec Command="taskkill /F /IM $(ExecutableName)" ContinueOnError="true" IgnoreExitCode="true" />
	</Target>
</Project>
