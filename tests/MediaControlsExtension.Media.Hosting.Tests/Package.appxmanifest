  xmlns:uap7="http://schemas.microsoft.com/appx/manifest/uap/windows10/7"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap7 rescap">
  <Identity Name="JPSoftworks.MediaBackendHostSpike" Publisher="CN=735F2779-478E-4220-AA28-465CBADFF852" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Media backend host spike</DisplayName>
    <PublisherDisplayName>Jiri Polasek</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
