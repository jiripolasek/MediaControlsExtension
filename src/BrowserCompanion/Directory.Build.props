<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BrowserCompanionBuildKey)' != ''">
    <BaseIntermediateOutputPath>obj\Packaged\$(BrowserCompanionBuildKey)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\Packaged\$(BrowserCompanionBuildKey)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
